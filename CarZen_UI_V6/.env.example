# CarZen frontend build settings (reference only).
# Flutter does not read this file; pass values with --dart-define, e.g.
#   flutter run -d chrome --dart-define=API_BASE_URL=http://127.0.0.1:8000
# or keep them in a JSON file and use --dart-define-from-file=config.json

# Base URL of the CarZen backend, without the /v1 suffix.
API_BASE_URL=http://127.0.0.1:8000
